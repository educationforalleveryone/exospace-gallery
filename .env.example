APP_NAME="Exospace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# ── Production note ─────────────────────────────────────────────────────────
# For Coolify/production, set FILESYSTEM_DISK=public so uploaded images are
# served via the public/storage symlink. In local dev, 'local' works because
# we run `php artisan storage:link`.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── 2Checkout payment (set in production) ───────────────────────────────────
TWOCHECKOUT_ACCOUNT_NUMBER=
TWOCHECKOUT_SECRET_WORD=
TWOCHECKOUT_PRODUCT_ID_PRO=
TWOCHECKOUT_PRODUCT_ID_STUDIO=

# ── Resend mail (set in production) ─────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="Exospace Gallery"

# ── Coolify custom-domain automation (set in production) ────────────────────
# Used by app/Services/CoolifyDomainManager.php to auto-provision Studio-plan
# custom domains. Leave blank in local dev.
COOLIFY_API_TOKEN=
COOLIFY_API_BASE_URL=

