APP_NAME="Exospace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── APP_KEY rotation (P3-6) ─────────────────────────────────────────────
# If you need to rotate APP_KEY (e.g. after a security incident):
#   1. Generate a new key: php artisan key:generate
#   2. Set APP_PREVIOUS_KEYS to the OLD key (comma-separated for multiple):
#      APP_PREVIOUS_KEYS=base64:oldKeyHere
#   3. Update APP_KEY in .env to the new key
#   4. Deploy + clear config cache: php artisan config:cache
#   5. All encrypted-at-rest data (MFA secrets) will be re-decryptable
#      using the previous key during the transition period.
#   6. Once all encrypted data has been re-encrypted with the new key
#      (e.g. by having each super-admin re-setup MFA), remove
#      APP_PREVIOUS_KEYS.
APP_PREVIOUS_KEYS=

# ── Business postal address (P0-3: CAN-SPAM §316.2 compliance) ──────────
# Required for commercial email compliance. This address appears in the
# footer of every marketing and transactional email. Use a real postal
# address (PO Box, office, or registered agent). Multi-line with \n.
# Example: "Exospace Gallery\n123 Main St, Suite 100\nSan Francisco, CA 94101"
EXOSPACE_BUSINESS_ADDRESS=

# ── Supplier VAT/GST details (Iter-008 / audit 2CO-7 + O-10) ────────────
# The supplier's own VAT/GST/Tax ID. Rendered on every invoice PDF.
# Used to determine reverse-charge applicability for B2B EU sales.
#
# Leave EXOSPACE_SUPPLIER_VAT_NUMBER empty if you have no VAT registration —
# invoices will be issued with 0% tax and no supplier VAT number.
#
# Examples:
#   US supplier (no VAT):     EXOSPACE_SUPPLIER_VAT_NUMBER=  + EXOSPACE_SUPPLIER_COUNTRY=US
#   UK supplier:              EXOSPACE_SUPPLIER_VAT_NUMBER=GB123456789  + EXOSPACE_SUPPLIER_COUNTRY=GB
#   EU (Germany) supplier:    EXOSPACE_SUPPLIER_VAT_NUMBER=DE123456789  + EXOSPACE_SUPPLIER_COUNTRY=DE
EXOSPACE_SUPPLIER_VAT_NUMBER=
EXOSPACE_SUPPLIER_COUNTRY=US

# Fallback country code for GeoIP when customer location cannot be determined.
# Defaults to 'US' (no VAT charged for US customers on non-US suppliers).
EXOSPACE_TAX_DEFAULT_COUNTRY=US

# ── Trusted proxies (task C17 / CR-5 Iter-001) ─────────────────────────────
# Comma-separated IPs or CIDR ranges of the reverse proxy in front of this
# app. Coolify uses Traefik — find the subnet via:
#   docker network inspect coolify-network | grep Subnet
# Typical value: "172.16.0.0/12"
#
# CR-5 FIX (Iter-001): Default changed from '*' to '' (empty = fail-closed).
# In production, AppServiceProvider::boot() THROWS a RuntimeException if
# TRUSTED_PROXIES is empty or '*' — the container will not start. This
# prevents the host-header spoofing + rate-limit bypass attacks documented
# in audit CR-5.
#
# Acceptable values:
#   - specific IPs: "10.0.0.5,10.0.0.6"
#   - CIDR ranges: "172.16.0.0/12"  ← typical Coolify/Traefik value
#   - "" (empty)   — fail-closed, no proxies trusted (use for local dev)
#   - "*"          — DANGEROUS, only for legacy dev. Blocked in production.
#
# For local development (php artisan serve, no reverse proxy), leave empty.
# For Coolify production, set to the Traefik subnet (find via the command
# above). The PreflightCheck command also warns on '*' as a defense-in-depth.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# ── Production drivers ──────────────────────────────────────────────────
# TD-1 FIX: .env.example now ships with production-ready defaults.
# Local dev can override these in .env (copy from .env.example and change).
# These defaults ensure a fresh clone on Coolify works out of the box
# without manual config changes.

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Production logging ──────────────────────────────────────────────────
# LOG_STACK=daily gives 30-day rolling logs that survive redeploys
# (when storage/ is a persistent volume).
# P3-2: For structured JSON logging (Datadog/Loki/CloudWatch), use:
#   LOG_STACK=daily,json
LOG_DAILY_DAYS=30

# ── Sentry error tracking (P3-1) ─────────────────────────────────────────
# Optional but strongly recommended. Set SENTRY_LARAVEL_DSN to enable
# error tracking. Requires: composer require sentry/sentry-laravel
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
# Combined with mounting /app/storage/ as a persistent volume (see
# DEPLOYMENT.md), this gives you 30 days of rolling logs that survive
# redeploys.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exospace
DB_USERNAME=root
DB_PASSWORD=

# ── Optional: MySQL read replica (P3-15) ───────────────────────────────────
# When DB_READ_HOST is set, SELECT queries are routed to the replica and
# INSERT/UPDATE/DELETE go to the primary DB_HOST. Offloads analytics/dashboard
# reads from the primary. Comma-separated for multiple replicas (Laravel
# load-balances across them). Leave empty for single-server setup.
# Example: DB_READ_HOST=10.0.0.5 or DB_READ_HOST=replica1,replica2
DB_READ_HOST=

# ── Optional: Sticky reads (PERF-22) ───────────────────────────────────────
# When true (default), once a write has occurred in the current request, all
# subsequent reads in that request go to the primary (not the replica) —
# preventing the "I just saved but the next read doesn't see it" race caused
# by MySQL async replication lag. Set to false only if you're confident your
# replica lag is < 1ms (e.g. Galera synchronous replication).
DB_STICKY=true

# ── Optional: Persistent PDO connections (PERF-22) ─────────────────────────
# When true, PHP keeps the MySQL connection open across requests within the
# same FPM worker. Eliminates the TCP+auth round-trip (~5-15ms) per request.
# Each FPM worker holds 1 idle connection — with 50 workers that's 50 conns,
# well under MySQL's default max_connections (151). Enable in production.
DB_PERSISTENT=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# TD-1: FILESYSTEM_DISK=public for single-container Coolify.
# P3-14: Set to 'cdn' for multi-container with S3/Spaces/R2.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── 2Checkout payment (set in production) ───────────────────────────────────
TWOCHECKOUT_ACCOUNT_NUMBER=
TWOCHECKOUT_SECRET_WORD=

# MANDATORY IN PRODUCTION: HMAC SHA-256 buy-link secret word.
# Configure 2Checkout to send the `signature` parameter via your merchant
# dashboard (Notifications → Advanced → HMAC SHA-256 signature), then set the
# buy-link secret word here. When set, the webhook verifies the signature
# field over the full IPN payload, preventing replay-tamper attacks where an
# attacker modifies customer_email / item_id / message_type on a captured
# valid IPN.
#
# P0-2: If this is empty in production, the webhook FAILS CLOSED (403 on
# every IPN) unless TWOCHECKOUT_ALLOW_MD5_ONLY=true is explicitly set.
# MD5 alone does NOT cover customer_email, item_id, message_type, or amount
# — anyone who captures one valid IPN can tamper with those fields and
# forge upgrades, refunds, or chargebacks.
TWOCHECKOUT_BUY_LINK_SECRET_WORD=

# EMERGENCY ESCAPE HATCH: Accept MD5-only webhooks (no HMAC verification).
# Defaults to false. Set to true ONLY during 2Checkout account migration or
# if the HMAC signature configuration is temporarily unavailable. Every
# webhook received in this mode logs a CRITICAL warning. NEVER leave this
# true in production long-term.
TWOCHECKOUT_ALLOW_MD5_ONLY=false

# Optional but strongly recommended: comma-separated allowlist of 2Checkout
# INS server IPs. 2Checkout publishes their INS IP ranges in the merchant
# documentation.
# Example: "198.61.180.0/22,162.242.218.0/24"
# Leave blank to accept from any IP (relies on HMAC signature verification
# as the primary defense). When blank in production, a CRITICAL warning is
# logged on every webhook — configure this for defense-in-depth.
TWOCHECKOUT_WEBHOOK_IP_ALLOWLIST=

TWOCHECKOUT_PRODUCT_ID_PRO=
TWOCHECKOUT_PRODUCT_ID_STUDIO=

# M-1: Recurring (subscription) product IDs. When set, the billing portal
# offers BOTH a one-time purchase AND a monthly subscription. When empty,
# only one-time purchases are offered. Create recurring products in the
# 2Checkout merchant dashboard (Catalog → Products → Recurring).
TWOCHECKOUT_RECURRING_PRODUCT_ID_PRO=
TWOCHECKOUT_RECURRING_PRODUCT_ID_STUDIO=

# M-1: Subscription pricing display (shown on pricing page + billing portal).
# These are DISPLAY-ONLY — the actual price is set in 2Checkout. Keep in sync.
TWOCHECKOUT_RECURRING_PRICE_PRO_MONTHLY=4.99
TWOCHECKOUT_RECURRING_PRICE_STUDIO_MONTHLY=14.99

# Optional: default coupon code applied to every upgrade URL. (Task H54)
# Set in 2Checkout merchant dashboard → Setup → Coupons. Leave blank
# for no default discount. Override per-link with ?coupon=XXXX.
TWOCHECKOUT_COUPON_CODE=

# SEC-8 FIX: Comma-separated allowlist of coupon codes that may be passed
# via ?coupon=XXXX on the /billing/upgrade/{plan} route. When a user-
# supplied coupon is not in this list, it is silently dropped (and the
# site-wide coupon above is used instead, if set). Example: "SUMMER20,LAUNCH50"
# Leave blank to reject ALL user-supplied coupons (only the site-wide
# default above is applied).
TWOCHECKOUT_COUPON_ALLOWLIST=

# Optional: default affiliate ID for 2Checkout affiliate program. (Task H58)
# Set in 2Checkout merchant dashboard → Affiliates. Leave blank for no
# default affiliate. Override per-link with ?ref=AFFILIATE_ID.
TWOCHECKOUT_AFFILIATE_ID=

# SEC-8 FIX: Comma-separated allowlist of affiliate IDs that may be passed
# via ?ref=ID on the /billing/upgrade/{plan} route. Same rationale as the
# coupon allowlist above. Leave blank to reject ALL user-supplied affiliate
# IDs (only the site-wide default above is applied).
TWOCHECKOUT_AFFILIATE_ALLOWLIST=

# ── Resend mail (set in production) ─────────────────────────────────────────
RESEND_API_KEY=

# ── Coolify custom-domain automation (set in production) ────────────────────
# Used by app/Services/CoolifyDomainManager.php to auto-provision Studio-plan
# custom domains. Leave blank in local dev.
COOLIFY_API_TOKEN=
COOLIFY_API_BASE_URL=

# ── Cloudflare Turnstile (optional, P3-19) ─────────────────────────────────
# Privacy-respecting CAPTCHA for public forms (contact, newsletter signup,
# event RSVP). Free, no quotas, no Google tracking. Invisible to most users.
#
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Create a widget with "Managed" challenge mode for the best UX.
#
# Leave BOTH blank to disable Turnstile (forms work without captcha — fine for
# local dev). Set BOTH in production to protect public forms from spam/abuse.
# The site_key is public (rendered in HTML); the secret_key is private.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Feature Flags (M-14) ──────────────────────────────────────────────────
# Toggle features on/off without code changes. Set to true/false.
# When false, the feature's routes return 404 and Blade @featureFlag blocks
# are hidden. Use this to safely roll out new features or quickly disable
# a broken feature in production.
#
# Available flags (see config/feature_flags.php for the full list):
#   FEATURE_FLAG_SUBSCRIPTIONS       — M-1 recurring subscription billing
#   FEATURE_FLAG_DUNNING            — M-9 dunning email sequence
#   FEATURE_FLAG_INVOICING          — M-10 PDF invoice generation
#   FEATURE_FLAG_COMPARISON_TABLE   — CONV-2 pricing comparison table
#   FEATURE_FLAG_TURNSTILE          — P3-19 Cloudflare Turnstile captcha
#   FEATURE_FLAG_TURBO_DRIVE        — PERF-26 Hotwire Turbo on admin pages
#   FEATURE_FLAG_ADMIN_IMPERSONATION — M-13 Login As User for super-admins
FEATURE_FLAG_SUBSCRIPTIONS=true
FEATURE_FLAG_DUNNING=true
FEATURE_FLAG_INVOICING=true
FEATURE_FLAG_COMPARISON_TABLE=true
FEATURE_FLAG_TURNSTILE=true
FEATURE_FLAG_TURBO_DRIVE=true
FEATURE_FLAG_ADMIN_IMPERSONATION=true

# ── OAuth/SSO providers (M-24) ────────────────────────────────────────────
# Optional: enable Google + GitHub login. When client_id is empty, the
# OAuth buttons are hidden and only email/password auth is available.
# Create credentials at:
#   Google: https://console.cloud.google.com/apis/credentials
#   GitHub: https://github.com/settings/developers
# Redirect URI: https://yourdomain.com/auth/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=/auth/github/callback

# ── M-23: Outbound webhooks (optional) ────────────────────────────────────
# When set, Exospace sends event notifications (gallery.published,
# user.upgraded, subscription.cancelled, etc.) to this URL as JSON POST
# requests with an HMAC-SHA256 signature header.
# Leave blank to disable outbound webhooks.
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=



# ── ITERATION 6/7: Weekly billing digest ──────────────────────────────────
# Comma-separated recipients for the weekly billing export email
# (exospace:send-billing-export, Mondays 07:00): trailing-7-day money
# events as a CSV attachment + week summary. Leave blank to disable.
#
# ITERATION 7: this env var is the FALLBACK recipient list. The primary
# source is the UI-managed billing_digest_recipients table on Master
# Control → Billing Review — once an admin adds even one recipient
# there, that list takes over (precedence in SendBillingExport:
# --to > DB list > BILLING_EXPORT_EMAIL). Set the env var as a
# zero-deploy-config seed, then hand off to the UI once deployed.
#
# NOTE: the CSV contains customer billing PII — every send is audit-logged
# as billing.exported (actor: system).
BILLING_EXPORT_EMAIL=

# ── ITERATION 7: Operational alert + backup configuration (operational alerts
# are wired in Iteration 5/6; .env.example was missing the rows). All optional;
# unset → log-only (Sentry picks up via Log::critical). See
# docs/MASTER_MANUAL_OPERATIONS.md §1 for the full reference.
OPERATIONAL_ALERT_WEBHOOK=
OPERATIONAL_ALERT_CRITICAL_WEBHOOK=
OPERATIONAL_ALERT_ERROR_WEBHOOK=
OPERATIONAL_ALERT_WARNING_WEBHOOK=
OPERATIONAL_ALERT_INFO_WEBHOOK=

# ── ITERATION 9: the escalation channel (the escape hatch). The digest
# watchdog's missing-digest alarm rides the same webhook it polices — if
# that webhook is dead, the alarm dies with it. When set, watchdog alarms
# are ADDITIONALLY posted here, independently (dedup still gates both
# posts; unset = exactly the pre-Iteration-9 behavior). Point this at a
# DIFFERENT failure domain than the primary — another Slack workspace's
# incoming webhook, or a personal DM webhook. An escalation URL in the
# same workspace as the primary defeats its own purpose. Rotated
# together with the other alert webhooks (§13).
OPS_ESCALATION_WEBHOOK=

# ── Backups (spatie/laravel-backup, Iteration 6 schedule + Iteration 7 heartbeats).
# BACKUP_DISKS=local,r2  → comma-separated; r2 disk defined in config/filesystems.php.
# BACKUP_PASSWORD=        → encryption passphrase for the zip archives.
# BACKUP_NOTIFICATION_EMAIL= → spatie's own failure notifications.
BACKUP_DISKS=local
BACKUP_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=admin@exospace.gallery

# ── OpsCenter: Operations Control Plane (Iteration 1) ─────────────────────
# Full documentation: docs/MASTER_MANUAL_OPERATIONS.md
# Coolify platform sync reuses COOLIFY_API_TOKEN / COOLIFY_API_BASE_URL /
# COOLIFY_APPLICATION_UUID already documented above — no new credentials.

# Enable the 5-minute Coolify platform sync (applications, deployments,
# databases, services, servers → the OpsCenter dashboard).
OPS_PLATFORM_SYNC_ENABLED=true

# Ingestion API tokens for OTHER applications reporting errors into
# OpsCenter: "slug=token,slug2=token2". Generate each with:
#   openssl rand -hex 24
# The slug becomes the application name in the dashboard. Empty = the
# endpoint is disabled entirely (fail-closed 404).
# Example: OPS_INGEST_TOKENS=project-b=9f86d081884c7d659a2feaa0c55ad015
OPS_INGEST_TOKENS=

# Minimum log level mirrored into the control plane by the ops log tap
# (channel 'ops' — add it via LOG_STACK=daily,ops to activate).
OPS_LOG_TAP_LEVEL=warning

# ops_events retention policy (days). Open events are never deleted.
OPS_EVENTS_AUTO_RESOLVE_DAYS=7
OPS_EVENTS_RESOLVED_RETENTION_DAYS=90

# ── OpsCenter: Diagnostic Engine & Actions (Iteration 3) ─────────────────
# Diagnostics are READ-ONLY, allow-listed checks (database, Redis, queue,
# containers, deployments, server, application) — no env vars required.
# Retention for diagnostic-run snapshots (days, pruned by ops:prune-events).
OPS_DIAGNOSTIC_RETENTION_DAYS=30

# Kill switch for the ACTION surface (restart container, replay webhook,
# sync-now). false = routes fail-closed (404) and the UI hides all actions.
# Diagnostics are unaffected — they are read-only.
OPS_ACTIONS_ENABLED=true

# ── OpsCenter: Sentry summary + Health Score + Sweeps (Iteration 4) ─────
# The Sentry API token is OPTIONAL and independent of SENTRY_LARAVEL_DSN
# above: the DSN reports errors TO Sentry (unchanged); this token READS
# issue summaries back for the OpsCenter overview tile. Without it the
# tile shows an honest "not configured" note and nothing else changes.
# Create at: sentry.io → Settings → Auth Tokens, scopes org:read +
# project:read (+ event:read where your org requires it).
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
# Comma-separated project slugs (strongly recommended — org-wide queries
# need broader token scopes).
SENTRY_PROJECT_SLUGS=
# Override only for self-hosted Sentry.
SENTRY_API_BASE_URL=https://sentry.io
SENTRY_SUMMARY_CACHE_MINUTES=10

# Scheduled diagnostic sweeps (ops:sweep-diagnostics, every 15 minutes):
# the same read-only Iteration-3 checks, run proactively. Degraded/failed
# results become control-plane events (deduplicated) + Slack alerts with
# their own dedup keys; recovery resolves the event automatically.
# false = the sweep command exits immediately (no-ops).
OPS_SWEEP_ENABLED=true
# Comma-separated self-scoped diagnostic ids (allow-list enforced; unknown
# or application-scoped ids are skipped with a warning).
OPS_SWEEP_DIAGNOSTICS=database.connectivity,redis.connectivity,queue.health,server.disk,app.scheduler
# Per-check cadences (Iteration 6): "probe at most every N minutes while
# HEALTHY" — id:minutes pairs. A check with an open sweep event is probed
# every sweep regardless (recovery detection is never delayed). Entries
# below the 15-minute sweep interval or for unknown ids are ignored with
# a warning. Empty = every check every sweep (the default).
# Example: OPS_SWEEP_CADENCES=server.disk:60,database.connectivity:60
OPS_SWEEP_CADENCES=

# ── OpsCenter: credential rotation reminders (Iteration 6) ───────────────
# ops:sweep-credentials (daily 09:00): ROTATE NOW / OVERDUE credential
# chips produce one warning Slack alert + one deduplicated SECURITY event
# (auto-resolved when everything is back in cadence); DUE-SOON-only sends
# a weekly info nudge. The /ops/credentials PAGE always works — this
# switch only gates the proactive reminder.
OPS_CREDENTIAL_REMINDERS_ENABLED=true

# ── OpsCenter: the morning digest (Iteration 7) ──────────────────────────
# ops:send-morning-digest (daily 08:15): ONE Slack message unifying health
# score + caps, incidents, untriaged errors, the application rollup,
# sweep findings, backups, the webhook ledger, the Sentry 24 h trend
# (omitted while SENTRY_API_TOKEN is unset), credential cadence and the
# last 24 h of operator activity. The silence contract: it sends on
# all-quiet days too, so a silent morning is itself a signal. This switch
# gates the SCHEDULED send only — the /ops/digest preview and the manual
# "Send now" button (super-admin, audited) keep working with it off.
OPS_MORNING_DIGEST_ENABLED=true

# ── OpsCenter: digest delivery watchdog (Iteration 8) ─────────────────────
# Meta-monitoring the monitor: daily at 08:45 (30 min after the 08:15
# digest) the watchdog verifies a digest actually went out THIS morning.
# A missing/stale stamp while the digest is enabled = the silence
# contract (§16.4) is broken → ONE warning Slack alert (dedup key
# ops.digest.missed) + ONE INFRASTRUCTURE event (source 'watchdog') that
# auto-resolves with a single recovery note the next healthy morning.
# Quiet when healthy. No-op while OPS_MORNING_DIGEST_ENABLED=false (a
# suspended contract cannot be broken).
OPS_DIGEST_WATCHDOG_ENABLED=true

# ── OpsCenter: weekly review digest (Iteration 8) ─────────────────────────
# The Monday deep-dive (08:30, inside the morning-briefing block):
# trailing-7-day trends the daily digest cannot show — error volume by
# category, incident throughput with MTTA/MTTR, deployment activity +
# failures, the sweep's finding history, current backup freshness and
# the week's operator activity. Informational — NOT a dead-man's switch
# (the digest + watchdog carry the silence contract); turning this off
# suspends nothing. The /ops/digest weekly preview + manual send keep
# working with it off.
# ITERATION 9: every delivery also persists its aggregate metrics as an
# ops_review_snapshots row (week-over-week deltas in the Monday message
# are computed live; the snapshots power the 8-week trend strip on
# /ops/digest). Retention below, pruned by ops:prune-events.
OPS_WEEKLY_REVIEW_ENABLED=true
OPS_WEEKLY_REVIEW_SNAPSHOT_RETENTION_DAYS=365

# ── OpsCenter: Sentry project mapping (Iteration 8) ───────────────────────
# Per-application Sentry trends need to know WHICH Sentry project each
# application is — configured PER APP from /ops/applications (super-
# admin panel at the bottom of the page; audited as ops.sentry.mapping).
# No env var: the mapping lives in the ops_applications table. The
# column renders once BOTH the mapping exists AND SENTRY_API_TOKEN /
# SENTRY_ORG_SLUG (Iteration 4) are set.

# ── OpsCenter: viewer access / RBAC (Iteration 5) ─────────────────────────
# Read-only /ops access for non-super-admins is granted PER USER from
# /ops/access (ops_access_grants table) — no env var needed to grant or
# revoke. This switch is the EMERGENCY kill: false instantly fail-closes
# EVERY viewer grant (super-admins unaffected); true restores them.
OPS_VIEWER_ACCESS_ENABLED=true
# Operator tier (Iteration 6): grants can also be issued at the OPERATOR
# level (read + run the read-only diagnostics from /ops/access — never
# the Actions hub, credentials or access management). Independent
# emergency kill for that tier only; viewer grants and super-admins are
# unaffected.
OPS_OPERATOR_ACCESS_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# TESTING CONTROL CENTER (QA Iteration 1)
# ─────────────────────────────────────────────────────────────────────────────
#
# Token CI runners must present in the X-QA-Token header to POST JUnit
# results to POST /api/control-center/runs. When EMPTY the endpoint is
# fail-closed 404 (convention matches /api/ops/ingest). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
QA_INGEST_TOKEN=

# Comma-separated e-mail addresses allowed to open /control-center and
# trigger runs from it (dashboard ships in iteration 2 — reserve now).
# Leave empty to keep that section disabled.
CONTROL_CENTER_ADMINS=

# ── MySQL fidelity target for suite execution (qa:run pre_release etc.) ─────
# Point these at an EPHEMERAL database only — never at production.
TEST_MYSQL_HOST=
TEST_MYSQL_PORT=3306
TEST_MYSQL_DATABASE=exospace_test
TEST_MYSQL_USERNAME=root
TEST_MYSQL_PASSWORD=

# Alert routing & thresholds for QA events (used from iteration 3).
QA_RELEASE_FRESHNESS_HOURS=48
QA_ALERT_DEDUP_TTL=1800
